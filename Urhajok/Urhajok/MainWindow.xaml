<Window x:Class="Urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Űrhajók" Height="450" Width="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Background="#FF172A3A">
            <TextBlock Text="Űrhajó műveletek" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Adatok betöltése" Height="22" Margin="6,0,6,10" Click="Betoltes_Click"/>
            <Button Content="Hány űrhajó van?" Height="22" Margin="6,0,6,10" Click="Darab_Click"/>
            <Button Content="Melyiknek a legnagyobb a hatótávja?" Height="22" Margin="6,0,6,10" Click="Hatotav_Click"/>
            <Button Content="Kik voltak sikeres küldetésen?" Height="22" Margin="6,0,6,10" Click="Sikeres_Click"/>
            <Button Content="Átlagos legénységszám" Height="22" Margin="6,0,6,10" Click="Atlag_Click"/>
            <Button Content="Gyártók szerinti csoportosítás" Height="22" Margin="6,0,6,10" Click="Csoportositas_Click"/>
            <Button Content="Keresés név alapján" Height="22" Margin="6,0,6,10" Click="Kereses_Click"/>
            <TextBox x:Name="txtKereses" Height="22" Margin="6,0,6,10" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="txtEredmeny" Foreground="White" TextWrapping="Wrap" Margin="6,0,6,10" MinHeight="22"/>
        </StackPanel>

        <DataGrid x:Name="dgUrhajok" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nev" Binding="{Binding Nev}" Width="Auto"/>
                <DataGridTextColumn Header="Legenyseg" Binding="{Binding Legenyseg}" Width="Auto"/>
                <DataGridTextColumn Header="MaxHatotav" Binding="{Binding MaxHatotav}" Width="Auto"/>
                <DataGridTextColumn Header="UzemenyagSzint" Binding="{Binding UzemenyagSzint}" Width="Auto"/>
                <DataGridTextColumn Header="Gyarto" Binding="{Binding Gyarto}" Width="Auto"/>
                <DataGridTextColumn Header="KuldetesStatusz" Binding="{Binding KuldetesStatusz}" Width="Auto"/>
                <DataGridTextColumn Header="InditasEve" Binding="{Binding InditasEve}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
